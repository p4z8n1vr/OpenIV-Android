<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenIV" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="OpenIVButton" parent="android:style/Widget.Material.Light.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
    </style>
    <style name="OpenIVActionButton" parent="OpenIVButton">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">23sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="OpenIVDialogFields">
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">22dp</item>
        <item name="android:paddingTop">8dp</item>
    </style>
    <style name="OpenIVNameInput" parent="android:style/Widget.Material.Light.EditText">
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
