<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/archive_back"
            style="@style/OpenIVActionButton"
            android:layout_width="@dimen/control_height"
            android:layout_height="@dimen/control_height"
            android:contentDescription="@string/back"
            android:text="@string/back_symbol" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/archive_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/archive_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="@dimen/detail_text_size" />
        </LinearLayout>

        <Button
            android:id="@+id/archive_actions"
            style="@style/OpenIVActionButton"
            android:layout_width="@dimen/control_height"
            android:layout_height="@dimen/control_height"
            android:contentDescription="@string/archive_actions"
            android:text="@string/more_symbol" />
    </LinearLayout>

    <TextView
        android:id="@+id/unsaved_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="68dp"
        android:paddingEnd="@dimen/content_padding"
        android:paddingBottom="4dp"
        android:text="@string/unsaved"
        android:textColor="@color/accent"
        android:textSize="@dimen/detail_text_size"
        android:textStyle="bold"
        android:visibility="gone" />

    <EditText
        android:id="@+id/archive_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/control_height"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="10dp"
        android:background="@drawable/card_background"
        android:hint="@string/search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/content_padding"
        android:textSize="15sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/archive_entries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingHorizontal="@dimen/content_padding"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/empty_entries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/empty_folder"
            android:textColor="@color/muted"
            android:textSize="@dimen/body_text_size" />
    </FrameLayout>
</LinearLayout>
