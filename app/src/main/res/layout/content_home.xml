<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="@dimen/content_padding">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_archive" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/home_description"
            android:textColor="@color/muted"
            android:textSize="@dimen/body_text_size" />

        <Button
            android:id="@+id/open_archive"
            style="@style/OpenIVButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/accent"
            android:minHeight="52dp"
            android:paddingHorizontal="22dp"
            android:text="@string/open_archive"
            android:textColor="@color/surface_card" />

        <Button
            android:id="@+id/key_options"
            style="@style/OpenIVButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/load_key" />

        <Button
            android:id="@id/access_status"
            style="@style/OpenIVButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/access_diagnostics" />
    </LinearLayout>
</ScrollView>
